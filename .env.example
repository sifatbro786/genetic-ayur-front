# Genetic Ayur storefront Copy to .env and fill in.
# On Vercel, set the same names in Project > Settings > Environment Variables.

# Public URL of the Express API (browser calls: order form, order page, dashboard).
# Live: https://api.<domain>
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: URL the Next.js server uses for its own fetches. Leave empty to use
# NEXT_PUBLIC_API_URL.
API_URL=

# This site's own public URL (canonical links, Open Graph). Live: https://<domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same value as REVALIDATE_SECRET in genetic-ayur-back/.env. The API sends it
# when the dashboard saves, so the cached pages refresh at once.
REVALIDATE_SECRET=
